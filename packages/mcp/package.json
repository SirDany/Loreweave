{
  "name": "@loreweave/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Model Context Protocol (MCP) server for Loreweave agentic workbench.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "loreweave-mcp": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin.js",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@loreweave/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  }
}
