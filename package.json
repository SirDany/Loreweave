{
  "name": "loreweave",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Agentic book-writing workbench: markdown + YAML canon, Copilot agents, local-first web UI.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:all": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @loreweave/web build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "lw": "pnpm --filter @loreweave/cli start --",
    "start": "node scripts/launch.mjs",
    "dev": "pnpm --filter @loreweave/web dev",
    "dev:web": "pnpm --filter @loreweave/web dev",
    "mcp": "pnpm --filter @loreweave/mcp start"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "vite@>=8.0.0 <=8.0.15": ">=8.0.16",
      "js-yaml@<3.15.2": "^3.15.2",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2",
      "brace-expansion@>=2.0.0 <2.1.3": ">=2.1.3",
      "postcss@<=8.5.22": ">=8.5.23",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4",
      "nanoid@<3.3.16": ">=3.3.16",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18",
      "postcss-selector-parser@>=6.1.0 <6.1.3": ">=6.1.3",
      "browserslist@<=4.28.6": ">=4.28.7",
      "nanoid@<3.3.12": ">=3.3.12",
      "@xmldom/xmldom@>=0.7.0 <=0.8.14": ">=0.8.15",
      "@ai-sdk/provider-utils@>=4.0.0-beta.10 <4.0.33": "^4.0.33",
      "@ai-sdk/provider-utils@<3.0.28": "^3.0.28",
      "vitest@>=2.1.0 <4.1.11": ">=4.1.11",
      "@vitest/mocker@>=2.1.0 <4.1.11": ">=4.1.11",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": ">=2.11.0",
      "@xmldom/xmldom@>=0.7.0 <=0.8.13": ">=0.8.14",
      "brace-expansion@>=2.0.0 <2.1.7": ">=2.1.7",
      "brace-expansion@>=2.0.0 <2.1.6": ">=2.1.6",
      "brace-expansion@>=2.0.0 <2.1.5": ">=2.1.5",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "vite@>=8.0.0 <=8.1.5": ">=8.1.6",
      "@vitest/mocker@>=2.1.0-beta.7 <4.1.12": ">=4.1.12",
      "zod@<4.6.6": ">=4.6.6",
      "postcss-selector-parser@<6.1.5": ">=6.1.5",
      "glob@>=9.0.0 <=14.0.1": ">=14.0.2",
      "minimatch@>=7.0.0 <11.0.1": ">=11.0.1"
    }
  }
}
